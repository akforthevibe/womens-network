---
import ScriptHeading from "./ScriptHeading.astro";
import { site, href, mailto, nav } from "../data/site";
import { credits } from "../data/photos";
const links = [
  ...nav,
  { label: "Privacy", href: "/privacy" },
  { label: "Instagram", href: href(site.links.instagram) },
  { label: "LinkedIn", href: href(site.links.linkedin) },
  { label: "Contact", href: mailto("DD Network") },
];
---
<footer class="on-dark bg-plum pb-28 pt-[100px] text-paper md:pt-[140px] lg:pb-14">
  <div class="wrap">
    <ScriptHeading as="p" size="h1" text="See you in the room." script="room" class="max-w-[13ch] lg:max-w-none" />
    <div class="mt-20 grid gap-12 border-t border-paper/20 pt-10 md:mt-28 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="text-[22px] font-black tracking-[0.03em]">DD Network</p>
        <p class="mt-1 text-[15px] font-semibold opacity-80">by Decoding Draupadi</p>
      </div>
      <nav aria-label="Footer" class="md:col-span-8">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-3 font-semibold sm:grid-cols-3">
          {links.map((l) => (
            <li><a href={l.href} class="inline-block py-1 opacity-90 hover:text-amber hover:opacity-100">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="mt-16 flex flex-col gap-3 text-[14px] opacity-70 md:flex-row md:justify-between">
      <p>DD Network · First chapter: Mumbai · 2026</p>
      <p>
        Photos: {credits.map((c, i) => <>{i > 0 && ", "}<a href={c.url} class="underline underline-offset-2" rel="noopener">{c.name}</a></>)}
      </p>
    </div>
  </div>
</footer>
