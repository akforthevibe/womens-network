---
import ScriptHeading from "./ScriptHeading.astro";
import Arrow from "./Arrow.astro";
import { companySeats } from "../data/content";
const links = { network: { label: "Sponsor Member seats", href: "/companies?seat=network#talk" }, circle: { label: "Talk to us about Circle", href: "/companies?seat=circle#talk" } };
---
<section id="companies" class="section bg-paper" aria-labelledby="companies-title">
  <div class="wrap">
    <div class="grid-12 items-end gap-y-6">
      <div class="md:col-span-7">
        <p class="eyebrow reveal text-crimson">For companies</p>
        <ScriptHeading id="companies-title" text="Give your best women the room." script="room" class="reveal mt-6" />
      </div>
      <p class="lede reveal d1 md:col-span-4 md:col-start-9 md:pb-2">The benefit they'll actually use, because it exists outside the office.</p>
    </div>

    <div class="mt-14 grid border-t-2 border-maroon md:mt-16 md:grid-cols-2">
      {companySeats.map((s, i) => (
        <article class:list={["reveal py-10 md:py-12", i === 0 ? "border-b border-maroon/15 md:border-b-0 md:border-r md:pr-12" : "md:pl-12", i === 1 && "d1"]}>
          <h3 class="eyebrow text-crimson">{s.title}</h3>
          <p class="mt-5 text-[24px] font-extrabold leading-[1.2] tracking-[-0.015em] md:text-[28px]">{s.teaser}</p>
          <p class="mt-6 text-[20px] font-black">{s.price} <span class="font-semibold opacity-70">/ seat / year</span></p>
          {s.key === "network" && <p class="small mt-1 opacity-80">Includes the full Member experience.</p>}
          <a href={links[s.key as "network" | "circle"].href} data-companies class="tlink mt-7">{links[s.key as "network" | "circle"].label} <Arrow /></a>
        </article>
      ))}
    </div>

    <div class="reveal mt-6 grid gap-6 rounded-[24px] bg-cream p-7 md:mt-10 md:grid-cols-12 md:items-center md:p-10">
      <div class="md:col-span-8">
        <h3 class="text-[26px] font-black leading-tight tracking-[-0.02em] md:text-[30px]">One contract. Simple reporting.</h3>
        <p class="mt-3 opacity-85">We onboard each woman personally and give the company an aggregate quarterly report covering attendance, satisfaction and overall outcomes. Individual conversations stay private.</p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a href="/companies" class="tlink">For companies <Arrow /></a>
      </div>
    </div>
  </div>
</section>
