---
// One curved hand-drawn arrow, pointing down and to the right by default.
interface Props { class?: string }
const { class: className = "" } = Astro.props;
---
<svg class:list={["draw pointer-events-none", className]} viewBox="0 0 120 90" fill="none" aria-hidden="true" focusable="false"><path d="M6 10 C 40 4, 86 18, 96 72" pathLength="1" stroke="var(--color-fire)" stroke-width="3.5" stroke-linecap="round" /><path d="M80 60 L 97 76 L 110 56" pathLength="1" stroke="var(--color-fire)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
