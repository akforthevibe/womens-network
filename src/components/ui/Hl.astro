---
// The one highlighted word per headline: Fraunces italic, fire, with a flame squiggle.
interface Props { tone?: "fire" | "flame" }
const { tone = "fire" } = Astro.props;
---
<em class:list={["hl", tone === "flame" && "!text-flame"]}><slot /><svg class="draw" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M2 8 C 22 2, 38 2, 54 7 S 88 12, 106 6 S 142 1, 160 6 S 188 10, 198 5" fill="none" stroke="var(--color-flame)" stroke-width="3.5" stroke-linecap="round" vector-effect="non-scaling-stroke" /></svg></em>
