---
type Bg = "paper" | "cream" | "plum" | "magenta" | "crimson";
interface Props { id?: string; bg?: Bg; class?: string; label?: string; wrapClass?: string }
const { id, bg = "paper", class: className = "", label, wrapClass = "" } = Astro.props;
const bgClass = {
  paper: "bg-paper text-maroon",
  cream: "bg-cream text-maroon",
  plum: "on-dark bg-plum text-paper",
  magenta: "on-dark bg-magenta text-paper",
  crimson: "on-dark bg-crimson text-paper",
}[bg];
---
<section id={id} aria-label={label} class:list={[bgClass, "section relative", className]}>
  <div class:list={["wrap reveal", wrapClass]}><slot /></div>
</section>
