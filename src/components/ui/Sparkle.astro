---
// Small four-point sparkle.
interface Props { size?: number; color?: "amber" | "goldenrod" | "crimson"; class?: string }
const { size = 14, color = "amber", class: className = "" } = Astro.props;
---
<svg class:list={["inline-block shrink-0", className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 1 C 13 8, 16 11, 23 12 C 16 13, 13 16, 12 23 C 11 16, 8 13, 1 12 C 8 11, 11 8, 12 1 Z" fill={`var(--color-${color})`} /></svg>
