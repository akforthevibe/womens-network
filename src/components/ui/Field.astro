---
// Labelled form field with an inline error linked by aria-describedby.
interface Props { name: string; label: string; hint?: string; class?: string }
const { name, label, hint, class: className = "" } = Astro.props;
const id = `f-${name}`;
---
<div class:list={["field", className]} data-field={name}>
  <label for={id} class="block text-[15px] font-medium">{label}</label>
  {hint && <p id={`${id}-hint`} class="mt-0.5 text-[14px]">{hint}</p>}
  <div class="mt-2"><slot /></div>
  <p id={`${id}-error`} class="mt-1.5 hidden text-[14px] font-medium text-paprika" data-error></p>
</div>
