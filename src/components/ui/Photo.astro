---
import { photoUrl, photoSrcset, type Photo } from "../../data/photos";

interface Props {
  photo: Photo;
  shape?: "rounded" | "arch";
  block?: "flame" | "fire";
  ratio?: number; // height / width
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}

const {
  photo,
  shape = "rounded",
  block = "flame",
  ratio = 1.2,
  sizes = "(min-width: 1024px) 400px, 100vw",
  widths = [400, 640, 800, 1000],
  eager = false,
  class: className = "",
} = Astro.props;
const fallback = widths[Math.min(1, widths.length - 1)];
---
<figure
  class:list={["frame", shape === "arch" ? "frame-arch" : "frame-rounded", className]}
  style={`--frame-block: var(--color-${block}); aspect-ratio: 1 / ${ratio};`}
>
  <div class="frame-inner">
    <img
      src={photoUrl(photo, fallback, ratio)}
      srcset={photoSrcset(photo, widths, ratio)}
      sizes={sizes}
      alt={photo.alt}
      width={fallback}
      height={Math.round(fallback * ratio)}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
      onerror="this.style.visibility='hidden'"
    />
  </div>
</figure>
