---
import ScriptHeading from "./ScriptHeading.astro";
import Sticker from "./Sticker.astro";
import Doodle from "./Doodle.astro";
import { foundingBenefits } from "../data/content";
---
<section class="on-dark section relative overflow-hidden bg-magenta text-paper" aria-labelledby="founding-title">
  <div class="wrap">
    <div class="grid-12 items-end gap-y-10">
      <div class="relative md:col-span-8">
        <p class="eyebrow reveal text-amber">Founding 50</p>
        <ScriptHeading id="founding-title" text="Be one of the first 50." script="50" size="h1" class="reveal mt-6 max-w-[10ch] !leading-[1.08] [&_.script]:ml-[0.08em] [&_.script]:text-[1.2em]" />
      </div>
      <div class="settle relative hidden justify-end md:col-span-4 md:flex" data-reveal>
        <Sticker top="Mumbai" bottom="Chapter one" colour="amber" size={168} tilt={-10} />
        <Doodle kind="ring" class="absolute -right-4 -top-4 h-[200px] w-[200px] text-gold" />
      </div>
    </div>

    <p class="reveal d1 mt-10 max-w-[26ch] text-[24px] font-extrabold leading-[1.2] tracking-[-0.01em] md:mt-14 md:text-[30px]">
      The first 50 women don't just join the network. They help decide what the network becomes.
    </p>

    <ol class="mt-14 grid gap-px overflow-hidden rounded-[24px] bg-paper/20 sm:grid-cols-2 md:mt-20 lg:grid-cols-4">
      {foundingBenefits.map((b, i) => (
        <li class:list={["reveal bg-magenta px-6 py-7 md:p-8", i && `d${i}`]}>
          <span class="text-[15px] font-black text-gold">{b.n}</span>
          <h3 class="mt-4 text-[22px] font-black uppercase leading-[1.05] tracking-[-0.01em] md:mt-12">{b.title}</h3>
          <p class="mt-3 opacity-90">{b.body}</p>
        </li>
      ))}
    </ol>

    <div class="reveal mt-14 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8 md:mt-16">
      <a href="#request" data-invite="founding" class="btn btn-paper">Request an invite</a>
      <p class="font-bold">Applications close 15 November 2026.</p>
    </div>
    <div class="settle mt-12 flex md:hidden" data-reveal>
      <Sticker top="Mumbai" bottom="Chapter one" colour="amber" size={128} tilt={-10} />
    </div>
  </div>
</section>
