---
import ScriptHeading from "./ScriptHeading.astro";
import Pillar from "./Pillar.astro";
import { pillars } from "../data/content";
---
<section id="the-room" class="section bg-cream" aria-labelledby="pillars-title">
  <div class="wrap">
    <div class="max-w-[820px]">
      <p class="eyebrow reveal text-crimson">What you get</p>
      <ScriptHeading id="pillars-title" text="Four things make the room work." script="room" class="reveal mt-6" />
    </div>
    <div class="mt-20 space-y-24 md:mt-28 md:space-y-36">
      {pillars.map((p, i) => <Pillar pillar={p} flip={i % 2 === 1} />)}
    </div>
  </div>
</section>
