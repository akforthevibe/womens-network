---
import ScriptHeading from "./ScriptHeading.astro";
import Doodle from "./Doodle.astro";
---
<section class="bg-paper pb-[96px] pt-[120px] md:pb-[150px] md:pt-[200px] lg:pt-[240px]" aria-labelledby="why-title">
  <div class="wrap text-center">
    <p class="eyebrow reveal text-crimson">Why DD Network</p>
    <div class="relative mx-auto mt-8 inline-block">
      <ScriptHeading id="why-title" text="Peers, not panels." script="panels" size="h1" class="reveal" />
      <Doodle kind="underline" class="absolute -bottom-5 right-[2%] h-6 w-[44%] text-amber md:-bottom-7" />
    </div>
    <p class="reveal d1 mx-auto mt-14 max-w-[22ch] text-[26px] font-extrabold leading-[1.15] tracking-[-0.02em] md:text-[34px]">
      The higher you go, the fewer women you can call.
    </p>
    <p class="lede reveal d2 mx-auto mt-6 max-w-[30em] opacity-85">
      You do not need another room full of name tags. You need people you can call when the decision matters.
    </p>
  </div>
</section>
