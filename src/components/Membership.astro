---
import ScriptHeading from "./ScriptHeading.astro";
import Sticker from "./Sticker.astro";
import ComparisonTable from "./ComparisonTable.astro";
import { memberFeatures, circleFeatures } from "../data/content";
---
<section id="membership" class="section bg-cream" aria-labelledby="membership-title">
  <div class="wrap">
    <div class="grid-12 items-end gap-y-6">
      <div class="md:col-span-7">
        <p class="eyebrow reveal text-crimson">Membership</p>
        <ScriptHeading id="membership-title" text="Choose your room." script="room" class="reveal mt-6" />
      </div>
      <p class="lede reveal d1 md:col-span-4 md:col-start-9 md:pb-2">Start with the network. Go deeper when you're ready.</p>
    </div>

    <div class="mt-14 grid gap-6 md:mt-20 lg:grid-cols-2 lg:gap-8">
      <!-- Member -->
      <article class="reveal flex flex-col rounded-[28px] bg-paper p-7 sm:p-10 lg:p-12" aria-labelledby="member-card">
        <p class="eyebrow text-crimson">Founding member</p>
        <h3 id="member-card" class="h3 mt-6">Member</h3>
        <p class="mt-3 text-[48px] font-black leading-none tracking-[-0.04em] md:text-[60px]">₹25,000<span class="text-[22px] font-bold tracking-normal opacity-70"> / year</span></p>
        <p class="mt-6 text-[20px] font-extrabold leading-snug">The room, the directory and the introductions.</p>
        <p class="mt-3 opacity-85">For women 7 to 20 years into their careers, businesses or independent work who want better people around them.</p>
        <div class="mt-9 space-y-7 border-t border-maroon/15 pt-8">
          {memberFeatures.map((g) => (
            <div>
              <h4 class="eyebrow text-crimson">{g.heading}</h4>
              <ul class="mt-3 space-y-2">
                {g.items.map((it) => <li class="flex gap-3"><span class="mt-[11px] h-1.5 w-1.5 shrink-0 rounded-full bg-maroon" aria-hidden="true"></span>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-auto pt-10">
          <div class="space-y-2 rounded-[18px] bg-cream p-5 text-[16px]">
            <p>Pay upfront or in 3 instalments.</p>
            <p class="font-extrabold">Founding members keep ₹25,000/year for two years.</p>
          </div>
          <a href="#request" data-invite="membership" class="btn btn-primary mt-6 w-full">Request an invite</a>
        </div>
      </article>

      <!-- Circle -->
      <article class="settle reveal d1 relative flex flex-col rounded-[28px] bg-plum p-7 text-paper sm:p-10 lg:p-12" aria-labelledby="circle-card" data-reveal>
        <div class="absolute -top-6 right-6 sm:right-10">
          <Sticker top="Opening Jan 2027" colour="amber" size={104} tilt={10} />
        </div>
        <p class="eyebrow text-amber">The Circle</p>
        <h3 id="circle-card" class="h3 mt-6">Circle</h3>
        <p class="mt-3 text-[48px] font-black leading-none tracking-[-0.04em] md:text-[60px]">₹65,000<span class="text-[22px] font-bold tracking-normal opacity-70"> / year</span></p>
        <p class="mt-6 text-[20px] font-extrabold leading-snug">A smaller table inside the network.</p>
        <p class="mt-3 opacity-90">For women 10+ years in who want a consistent group of senior peers, facilitated conversations and more active introductions.</p>
        <div class="mt-9 space-y-7 border-t border-paper/20 pt-8">
          {circleFeatures.map((g) => (
            <div>
              <h4 class="eyebrow text-amber">{g.heading}</h4>
              <ul class="mt-3 space-y-2">
                {g.items.map((it) => <li class="flex gap-3"><span class="mt-[11px] h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-auto pt-10">
          <a href="/?interest=circle#request" data-circle-waitlist class="btn btn-circle w-full">Join the Circle waitlist</a>
          <p class="small mt-4 text-center opacity-80">Membership included.</p>
        </div>
      </article>
    </div>

    <ComparisonTable />
  </div>
</section>
