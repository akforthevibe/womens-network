---
import Photo from "../ui/Photo.astro";
import Hl from "../ui/Hl.astro";
import Sparkle from "../ui/Sparkle.astro";
import Scribble from "../ui/Scribble.astro";
import Sticker from "../ui/Sticker.astro";
import { photos } from "../../data/photos";
---
<section class="bg-paper pb-[72px] pt-10 lg:pb-[112px] lg:pt-16" aria-labelledby="hero-title">
  <div class="wrap grid-12 items-center gap-y-14">
    <div class="lg:col-span-7">
      <p class="eyebrow text-paprika">A private network for women · Mumbai</p>
      <h1 id="hero-title" class="h1 mt-5 text-paprika">For women building their <Hl>next chapter.</Hl></h1>
      <p class="mt-7 text-[22px] leading-snug lg:text-[24px]">Inside a company or on your own.</p>
      <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-medium">
        <span>Get into the room</span><Sparkle /><span>Get seen</span><Sparkle /><span>Get introduced</span>
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#request" class="btn btn-primary" data-invite="hero">Request an invite</a>
        <a href="#newsletter" class="btn btn-secondary">Get the newsletter</a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[420px] lg:col-span-5 lg:max-w-none">
      <Scribble class="absolute -right-6 -top-10 z-0 w-[170px] lg:-right-10 lg:-top-12 lg:w-[220px]" />
      <Photo
        photo={photos.hero}
        shape="arch"
        block="flame"
        ratio={1.25}
        eager
        sizes="(min-width: 1024px) 460px, (min-width: 480px) 420px, 92vw"
        widths={[420, 640, 920]}
        class="relative z-10 mr-[14px]"
      />
      <Sticker id="sticker-hero" text="50 FOUNDING SEATS · BY APPLICATION · MUMBAI ·" class="absolute -bottom-8 -left-4 z-20 lg:-left-10" />
    </div>
  </div>
</section>
