---
import Photo from "../ui/Photo.astro";
import Script from "../ui/Script.astro";
import Scribble from "../ui/Scribble.astro";
import Sticker from "../ui/Sticker.astro";
import { photos } from "../../data/photos";
import { site, href } from "../../data/site";
---
<section class="bg-paper pb-[72px] pt-8 lg:pb-[112px] lg:pt-14" aria-labelledby="hero-title">
  <div class="wrap grid-12 items-center gap-y-14">
    <div class="lg:col-span-7">
      <p class="eyebrow text-crimson">By application · Mumbai</p>
      <h1 id="hero-title" class="h1 mt-5 text-crimson">The room you've been <Script>looking for.</Script></h1>
      <p class="lede mt-8 max-w-[34ch]">A private network for women in Mumbai building their next chapter, inside a company or on their own.</p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <a href="#request" class="btn btn-primary w-full sm:w-auto" data-invite="hero">Request an invite</a>
        <a href={href(site.links.whatsappGroup)} class="link self-start text-[16px] text-maroon sm:self-auto" data-whatsapp="hero">or join the free DD community →</a>
      </div>
      <p class="mt-5 text-[15px]">From ₹25,000 a year · 50 founding seats · Every application read by a person</p>
    </div>

    <div class="relative mx-auto w-full max-w-[420px] lg:col-span-5 lg:max-w-none">
      <Scribble class="absolute -right-4 -top-10 z-0 w-[170px] lg:-right-10 lg:-top-12 lg:w-[220px]" />
      <Photo
        photo={photos.hero}
        shape="arch"
        block="amber"
        ratio={1.25}
        eager
        sizes="(min-width: 1024px) 460px, (min-width: 480px) 420px, 92vw"
        widths={[420, 640, 920]}
        class="relative z-10 mr-[14px]"
      />
      <Sticker id="sticker-hero" text="50 FOUNDING SEATS · BY APPLICATION ·" class="absolute -bottom-8 -left-3 z-20 lg:-left-10" />
    </div>
  </div>
</section>
