---
import Section from "../ui/Section.astro";
import Photo from "../ui/Photo.astro";
import Hl from "../ui/Hl.astro";
import { photos } from "../../data/photos";

const cols = [
  { heading: "Building inside", items: ["Stepping up to a bigger role", "Leading a team for the first time", "Getting ready for what's next"] },
  { heading: "Building outside", items: ["Thinking about leaving", "Just left, working out what's next", "Building a practice or a company"] },
];
---
<Section id="who" bg="cream">
  <div class="grid-12 gap-y-10">
    <div class="lg:col-span-7">
      <p class="eyebrow text-paprika">Who it's for</p>
      <h2 class="h2 mt-4 text-paprika">For women on the <Hl>move.</Hl></h2>
    </div>

    <Photo
      photo={photos.who}
      block="fire"
      ratio={1.2}
      class="mr-[14px] w-full max-w-[420px] lg:col-span-4 lg:col-start-9 lg:row-span-3 lg:row-start-1 lg:max-w-none lg:self-center"
      sizes="(min-width: 1024px) 380px, 90vw"
      widths={[380, 600, 800]}
    />

    <div class="grid gap-8 sm:grid-cols-2 sm:gap-0 lg:col-span-7">
      {cols.map((c, i) => (
        <div class:list={["sm:px-8", i === 0 ? "sm:pl-0 sm:border-r-[1.5px] sm:border-wine" : "border-t-[1.5px] border-wine pt-8 sm:border-t-0 sm:pt-0 sm:pr-0"]}>
          <h3 class="text-[26px] text-paprika">{c.heading}</h3>
          <ul class="mt-4 space-y-2">{c.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      ))}
    </div>

    <p class="text-[19px] font-medium lg:col-span-7">Mumbai first. 7 to 20 years in. And the women who've done it, as our Founding Hosts.</p>
  </div>
</Section>
