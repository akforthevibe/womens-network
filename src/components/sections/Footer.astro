---
import { site, href, isPlaceholder } from "../../data/site";
import { credits } from "../../data/photos";
interface Props { home?: boolean }
const { home = true } = Astro.props;
const p = home ? "" : "/";
const contactLabel = isPlaceholder(site.contactEmail) ? `Contact (${site.contactEmail})` : "Contact";
const links = [
  { href: `${p}#the-room`, label: "The room" },
  { href: `${p}#membership`, label: "Membership" },
  { href: `${p}#circle`, label: "Circle" },
  { href: "/companies/", label: "For companies" },
  { href: `${p}#faq`, label: "FAQ" },
  { href: `${p}#founding-notes`, label: "Founding notes" },
  { href: href(site.links.instagram), label: "Instagram" },
  { href: href(site.links.linkedin), label: "LinkedIn" },
  { href: isPlaceholder(site.contactEmail) ? "#" : `mailto:${site.contactEmail}`, label: contactLabel },
  { href: "/privacy/", label: "Privacy" },
];
---
<footer class="on-dark bg-plum py-16 text-paper lg:py-20">
  <div class="wrap">
    <p class="text-[36px] font-extrabold leading-none tracking-tight lg:text-[48px]">DD Network</p>
    <p class="mt-2 font-script text-[44px] leading-tight text-goldenrod">See you in the room.</p>

    <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-1 font-semibold">
      {links.map((l) => <li><a class="inline-flex min-h-11 items-center hover:text-amber" href={l.href}>{l.label}</a></li>)}
    </ul>

    <p class="mt-8 text-[14px]">
      © 2026 Decoding Draupadi. Mumbai. · Photos from Unsplash ({credits.map((c, i) => (
        <><a class="underline underline-offset-2 hover:text-amber" href={c.url}>{c.name}</a>{i < credits.length - 1 ? ", " : ""}</>
      ))})
    </p>
  </div>
</footer>
