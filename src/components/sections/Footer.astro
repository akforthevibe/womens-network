---
import { site, href, isPlaceholder } from "../../data/site";
import { credits } from "../../data/photos";
const contactLabel = isPlaceholder(site.contactEmail) ? `Contact (${site.contactEmail})` : "Contact";
---
<footer class="bg-wine py-16 text-paper lg:py-20">
  <div class="wrap">
    <p class="font-display text-[34px] font-bold leading-none lg:text-[44px]">DD Network</p>
    <p class="mt-3 text-[19px]">For women building their next chapter.</p>

    <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 font-medium">
      <li><a class="hover:text-flame" href={href(site.links.instagram)}>Instagram</a></li>
      <li><a class="hover:text-flame" href={href(site.links.linkedin)}>LinkedIn</a></li>
      <li><a class="hover:text-flame" href="/#newsletter">Newsletter</a></li>
      <li><a class="hover:text-flame" href={isPlaceholder(site.contactEmail) ? "#" : `mailto:${site.contactEmail}`}>{contactLabel}</a></li>
      <li><a class="hover:text-flame" href="/privacy/">Privacy</a></li>
    </ul>

    <p class="mt-10 text-[14px]">
      © 2026 Decoding Draupadi. Mumbai. · Photos from Unsplash ({credits.map((c, i) => (
        <><a class="underline underline-offset-2 hover:text-flame" href={c.url}>{c.name}</a>{i < credits.length - 1 ? ", " : ""}</>
      ))})
    </p>
  </div>
</footer>
