---
import Section from "../ui/Section.astro";
import Script from "../ui/Script.astro";
import { site } from "../../data/site";

const faq = [
  ["Who else is in the room?", "Women in Mumbai, roughly 7 to 20 years in, building inside companies and building their own. Every one applied and spoke to us first."],
  ["Why apply instead of just joining?", "Because the room is the product. A short application and a call keep every woman you meet worth meeting."],
  ["How much time does it take?", "As much as you want. A mixer a month and a dinner when you can. This isn't a class you fall behind in."],
  ["How do introductions work?", "Tell us who you need. We find the right members, check they're happy to connect, and introduce you."],
  ["How are Circles matched?", "By seniority and by the challenge you're facing, so the women at your table are working on something close to yours."],
  ["Is what I share kept private?", "Yes. Circles sign a confidentiality agreement, introductions are double opt-in, and we never sell or share your details."],
  ["Can I pay in instalments, or expense it?", "Yes to both. Pay upfront or in 3 instalments; we issue GST invoices your company can use."],
  ["What if it isn't for me?", site.refundPolicy],
];
---
<Section id="faq" bg="paper">
  <div class="grid-12">
    <h2 class="h2 text-crimson lg:col-span-4">Fair <Script>questions.</Script></h2>
    <div class="lg:col-span-8">
      {faq.map(([q, a]) => (
        <details class="group border-b-[1.5px] border-maroon/20 first:border-t-[1.5px]" data-faq>
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[19px] font-bold text-plum lg:text-[22px] [&::-webkit-details-marker]:hidden">
            {q}
            <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="var(--color-crimson)" stroke-width="2.5" stroke-linecap="round">
              <path d="M4 12 H20" /><path d="M12 4 V20" class="group-open:hidden" />
            </svg>
          </summary>
          <p class="max-w-[60ch] pb-7">{a}</p>
        </details>
      ))}
    </div>
  </div>
</Section>
