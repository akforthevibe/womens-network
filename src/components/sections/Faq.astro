---
import Section from "../ui/Section.astro";
import Hl from "../ui/Hl.astro";
import { site } from "../../data/site";

const faq = [
  ["Who can join?", "Women in Mumbai with 7 to 20 years of experience, building their next chapter inside a company or on their own."],
  ["How do I join?", "Request an invite, answer a few questions, and have a short call with us."],
  ["What if I don't need anything this month?", "That's fine. You're paying to be in a room you can draw on when your next move needs it."],
  ["How do introductions work?", "Tell us what you need. We find the right members, check they're happy to connect, and introduce you."],
  ["Can my company pay?", "Yes. We issue GST invoices, and companies can sponsor seats."],
  ["What if it isn't for me?", site.refundPolicy],
];
---
<Section id="faq" bg="paper">
  <div class="grid-12">
    <h2 class="h2 text-paprika lg:col-span-4"><Hl>Questions.</Hl></h2>
    <div class="lg:col-span-8">
      {faq.map(([q, a]) => (
        <details class="group border-b-[1.5px] border-wine/20 first:border-t-[1.5px]" data-faq>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-display text-[21px] font-semibold text-paprika lg:text-[24px] [&::-webkit-details-marker]:hidden">
            {q}
            <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="var(--color-fire)" stroke-width="2.5" stroke-linecap="round">
              <path d="M4 12 H20" /><path d="M12 4 V20" class="group-open:hidden" />
            </svg>
          </summary>
          <p class="max-w-[60ch] pb-7">{a}</p>
        </details>
      ))}
    </div>
  </div>
</Section>
