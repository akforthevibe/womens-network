---
import Sparkle from "../ui/Sparkle.astro";
const rules = ["Women only", "No selling to members", "Introductions only when both say yes", "Your data is never sold or shared"];
---
<section class="bg-paper py-12 lg:py-16" aria-label="House rules">
  <ul class="wrap flex flex-col items-center gap-3 text-center text-[15px] font-medium sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-4">
    {rules.map((r, i) => (
      <li class="flex items-center gap-4">
        {i > 0 && <span class="hidden sm:inline-flex"><Sparkle size={12} /></span>}
        <span>{r}</span>
      </li>
    ))}
  </ul>
</section>
