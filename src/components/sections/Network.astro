---
import Section from "../ui/Section.astro";
import Photo from "../ui/Photo.astro";
import Hl from "../ui/Hl.astro";
import Arrow from "../ui/Arrow.astro";
import { photos } from "../../data/photos";

const cards = [
  {
    n: "01", title: "Get into the room", photo: photos.meet,
    body: "A vetted network of women at your stage. Monthly mixers, small dinners and a directory of who's who.",
    cls: "bg-paprika text-paper", block: "flame" as const,
  },
  {
    n: "02", title: "Get seen", photo: photos.seen,
    body: "Features in DD's newsletter and podcast. Speaking slots through Draupadi on the Dais. Journalist requests every week.",
    cls: "bg-fire text-paper", block: "flame" as const,
  },
  {
    n: "03", title: "Get introduced", photo: photos.introduced,
    body: "Need someone specific? Ask us. We make a warm introduction when you both say yes.",
    cls: "bg-flame text-wine", block: "fire" as const,
  },
];
---
<Section id="the-network" bg="paper">
  <p class="eyebrow text-paprika">The network</p>
  <h2 class="h2 mt-4 max-w-[16ch] text-paprika">Three things <Hl>change</Hl> when you're in.</h2>

  <ol class="mt-14 grid gap-6 lg:mt-20 lg:grid-cols-3">
    {cards.map((c, i) => (
      <li class:list={["card relative flex flex-col p-5 pb-8 lg:p-6 lg:pb-10", c.cls, i === 2 && "mt-16 lg:mt-0"]}>
        {i === 2 && (
          <p class="absolute -top-14 right-2 flex items-start gap-1 lg:-top-[84px] lg:right-auto lg:left-6">
            <span class="font-hand text-[24px] leading-none text-fire lg:text-[26px]">the part nobody else does</span>
            <Arrow class="mt-2 h-[52px] w-[60px] lg:h-[64px] lg:w-[74px]" />
          </p>
        )}
        <Photo photo={c.photo} block={c.block} ratio={0.72} class="mb-8 mr-[14px]" sizes="(min-width: 1024px) 360px, 90vw" widths={[360, 560, 760]} />
        <span class="font-display text-[64px] font-bold leading-none lg:text-[80px]">{c.n}</span>
        <h3 class="mt-3 text-[28px] leading-tight lg:text-[32px]">{c.title}</h3>
        <p class="mt-3">{c.body}</p>
      </li>
    ))}
  </ol>
</Section>
