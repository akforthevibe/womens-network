---
import Section from "../ui/Section.astro";
import Hl from "../ui/Hl.astro";

// Swap in confirmed hosts: { name, title, photo } with photo an image URL.
// Until then each slot shows a flame tile reading "Announcing soon".
type Host = { name: string; title: string; photo?: string };
const hosts: Host[] = Array.from({ length: 6 }, () => ({ name: "", title: "" }));
---
<Section id="hosts" bg="cream">
  <p class="eyebrow text-paprika">Founding Hosts</p>
  <h2 class="h2 mt-4 text-paprika">Hosted by women who've <Hl>done it.</Hl></h2>
  <p class="mt-6 max-w-[52ch]">Founders, leaders and operators who host dinners, hold office hours and make introductions.</p>

  <ul class="mt-12 grid grid-cols-3 gap-x-4 gap-y-8 lg:grid-cols-6 lg:gap-x-6">
    {hosts.map((h) => (
      <li class="flex flex-col items-center text-center">
        {h.name ? (
          <>
            <img src={h.photo} alt={`Portrait of ${h.name}`} loading="lazy" decoding="async" width="160" height="160" class="aspect-square w-full max-w-[160px] rounded-full object-cover" style="filter: grayscale(1) contrast(1.1)" />
            <p class="mt-4 font-display text-[20px] font-bold text-paprika">{h.name}</p>
            <p class="text-[15px]">{h.title}</p>
          </>
        ) : (
          <div class="flex aspect-square w-full max-w-[160px] items-center justify-center rounded-full bg-flame">
            <span class="font-hand text-[18px] leading-tight sm:text-[24px] lg:text-[26px] text-wine">Announcing<br />soon</span>
          </div>
        )}
      </li>
    ))}
  </ul>

  <p class="mt-12"><a href="/?as=host#request" class="link text-paprika" data-host-link>Want to host? Tell us →</a></p>
</Section>
