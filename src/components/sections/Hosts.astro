---
import Section from "../ui/Section.astro";
import Script from "../ui/Script.astro";
import { hosts } from "../../data/hosts";
---
<Section id="hosts" bg="paper">
  <p class="eyebrow text-crimson">Founding Hosts</p>
  <h2 class="h2 mt-4 text-plum">Hosted by women who've <Script>done it.</Script></h2>
  <p class="mt-8 max-w-[52ch]">The founder who scaled. The leader who stepped off the ladder and built her own. They host the dinners, hold office hours and open doors.</p>

  <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
    {hosts.map((h) => (
      <li class="flex flex-col items-center text-center">
        {h.name && h.photo ? (
          <img src={h.photo} alt={`Portrait of ${h.name}`} loading="lazy" decoding="async" width="160" height="160" class="aspect-square w-full max-w-[150px] rounded-full object-cover" style="filter: grayscale(1) contrast(1.1)" />
        ) : (
          <div class="flex aspect-square w-full max-w-[150px] items-center justify-center rounded-full bg-amber" aria-hidden="true">
            <span class="font-script text-[44px] leading-none text-maroon">Soon</span>
          </div>
        )}
        <p class="mt-4 font-bold text-plum">{h.name || "[Host name]"}</p>
        {h.name && <p class="text-[15px]">{h.role}, {h.company}</p>}
      </li>
    ))}
  </ul>

  <p class="mt-12"><a href="?interest=host#request" class="link text-crimson" data-host-link>Want to host? Tell us →</a></p>
</Section>
