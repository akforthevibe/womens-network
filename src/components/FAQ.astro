---
import ScriptHeading from "./ScriptHeading.astro";
import { faqs } from "../data/content";
---
<section id="faq" class="section bg-cream" aria-labelledby="faq-title">
  <div class="wrap grid-12 gap-y-12">
    <div class="md:col-span-4">
      <div class="md:sticky md:top-32">
        <p class="eyebrow reveal text-crimson">FAQ</p>
        <ScriptHeading id="faq-title" text="Fair questions." script="questions" class="reveal mt-6" />
      </div>
    </div>
    <div class="md:col-span-8 md:col-start-5 lg:col-span-7 lg:col-start-6">
      <div class="border-t-2 border-maroon">
        {faqs.map((f) => (
          <details class="faq group border-b border-maroon/15" data-faq>
            <summary class="flex min-h-[64px] cursor-pointer items-start justify-between gap-6 py-6 text-[20px] font-extrabold leading-snug tracking-[-0.01em] md:text-[22px]">
              <h3 class="font-extrabold">{f.q}</h3>
              <span class="plus mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper text-crimson" aria-hidden="true">
                <svg viewBox="0 0 14 14" class="h-3 w-3"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
              </span>
            </summary>
            <p class="max-w-[36em] pb-7 pr-12 opacity-90">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
