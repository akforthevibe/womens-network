---
import ScriptHeading from "./ScriptHeading.astro";
import Field from "./Field.astro";
import Doodle from "./Doodle.astro";
import Arrow from "./Arrow.astro";
import { site, href } from "../data/site";

const describes = ["I lead inside a company", "I run my own company", "I work independently", "A mix of the above"];
const interests = [
  { label: "Member", key: "member" },
  { label: "Circle", key: "circle" },
  { label: "Founding Host", key: "host" },
  { label: "Company seats", key: "company" },
];
const heard = ["Instagram", "WhatsApp", "A friend", "Decoding Draupadi", "An event", "LinkedIn", "Other"];
const utm = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
---
<section id="request" class="bg-paper pb-[88px] pt-[100px] md:pb-[120px] md:pt-[160px]" aria-labelledby="request-title">
  <div class="wrap grid-12 gap-y-14">
    <div class="md:col-span-5">
      <div class="md:sticky md:top-32">
        <p class="eyebrow reveal text-crimson">Your turn</p>
        <div class="relative inline-block">
          <ScriptHeading id="request-title" text="Request an invite." script="invite" class="reveal mt-6" />
          <Doodle kind="underline" class="absolute -bottom-4 left-[38%] h-5 w-[58%] text-amber" />
        </div>
        <p class="lede reveal d1 mt-10 max-w-[22em] font-semibold">Five minutes. A few honest answers. Then a 20-minute conversation with us.</p>
        <p class="reveal d1 mt-4 max-w-[24em] opacity-85">If the room feels right for you, we'll save you a seat.</p>
      </div>
    </div>

    <div class="md:col-span-7 lg:col-span-6 lg:col-start-7" data-invite-card>
      <form
        name="invite"
        method="POST"
        action="/thanks"
        data-netlify="true"
        netlify-honeypot="company_website"
        novalidate
        data-invite-form
        data-current="1"
        class="rounded-[28px] bg-cream p-6 sm:p-10"
      >
        <input type="hidden" name="form-name" value="invite" />
        <input type="hidden" name="source" value="direct" data-source />
        {utm.map((u) => <input type="hidden" name={u} value="" data-utm={u} />)}
        <p class="hidden" aria-hidden="true"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>

        <div class="flex items-center justify-between gap-4 border-b border-maroon/15 pb-5">
          <p class="eyebrow">Request an invite</p>
          <p class="text-[14px] font-black tabular-nums" data-step-count aria-live="polite"><span data-step-label>1 / 2</span><span class="sr-only"> steps</span></p>
        </div>

        <!-- Step one -->
        <fieldset data-step="1" class="mt-8 min-w-0">
          <legend class="text-[26px] font-black leading-tight tracking-[-0.02em] md:text-[30px]" tabindex="-1">First, tell us about you.</legend>
          <div class="mt-8 grid gap-7 sm:grid-cols-2">
            <Field name="name" label="Full name" class="sm:col-span-2">
              <input id="f-name" name="name" class="input" autocomplete="name" required aria-describedby="f-name-error" />
            </Field>
            <Field name="email" label="Email">
              <input id="f-email" name="email" type="email" class="input" autocomplete="email" required aria-describedby="f-email-error" />
            </Field>
            <Field name="whatsapp" label="WhatsApp number">
              <input id="f-whatsapp" name="whatsapp" type="tel" class="input" autocomplete="tel" inputmode="tel" placeholder="+91" required aria-describedby="f-whatsapp-error" />
            </Field>
            <Field name="linkedin" label="LinkedIn" class="sm:col-span-2">
              <input id="f-linkedin" name="linkedin" type="url" class="input" inputmode="url" placeholder="linkedin.com/in/yourname" required aria-describedby="f-linkedin-error" />
            </Field>
          </div>

          <Field name="describes" label="Which best describes you?" group class="mt-10">
            <div class="flex flex-wrap gap-2.5">
              {describes.map((d) => (
                <label class="choice"><input type="radio" name="describes" value={d} required /><span>{d}</span></label>
              ))}
            </div>
          </Field>

          <Field name="interest" label="What are you interested in?" group class="mt-9">
            <div class="flex flex-wrap gap-2.5">
              {interests.map((it) => (
                <label class="choice"><input type="radio" name="interest" value={it.label} data-interest={it.key} required /><span>{it.label}</span></label>
              ))}
            </div>
          </Field>

          <button type="button" class="btn btn-primary mt-10 hidden w-full sm:w-auto [.js_&]:inline-flex" data-next>Next <Arrow /></button>
        </fieldset>

        <!-- Step two -->
        <fieldset data-step="2" class="mt-8 min-w-0">
          <legend class="text-[26px] font-black leading-tight tracking-[-0.02em] md:text-[30px]" tabindex="-1">Now, tell us what you're looking for.</legend>
          <div class="mt-8 space-y-8">
            <Field name="need" label="What do you need in the next 90 days?">
              <textarea id="f-need" name="need" class="input mt-2" rows="5" maxlength="1200" required aria-describedby="f-need-error"></textarea>
            </Field>
            <Field name="offer" label="What could another member come to you for?">
              <textarea id="f-offer" name="offer" class="input mt-2" rows="5" maxlength="1200" required aria-describedby="f-offer-error"></textarea>
            </Field>
            <Field name="heard" label="How did you hear about DD Network?" group>
              <div class="flex flex-wrap gap-2.5">
                {heard.map((h) => (
                  <label class="choice"><input type="radio" name="heard" value={h} required /><span>{h}</span></label>
                ))}
              </div>
            </Field>
            <div data-field="consent">
              <label class="check">
                <input type="checkbox" name="consent" value="yes" required aria-describedby="f-consent-error" />
                <span class="text-[16px] leading-snug">I agree to DD Network storing my answers to review my application and make relevant introductions.</span>
              </label>
              <p id="f-consent-error" class="error" hidden data-error></p>
            </div>
          </div>

          <p class="error mt-6" role="alert" hidden data-form-error></p>
          <div class="mt-10 flex flex-col-reverse gap-4 sm:flex-row sm:items-center">
            <button type="button" class="tlink hidden self-start sm:mr-auto [.js_&]:inline-flex" data-back>
              <Arrow class="rotate-180" /> Back
            </button>
            <button type="submit" class="btn btn-primary w-full sm:w-auto" data-submit>Send my request</button>
          </div>
          <p class="small mt-5 opacity-80">We read every application ourselves. You'll hear from us within {site.replyTime}.</p>
        </fieldset>
      </form>

      <!-- Thank you state, shown in place of the form -->
      <div class="hidden rounded-[28px] bg-plum p-6 text-paper on-dark sm:p-12" tabindex="-1" data-thanks>
        <p class="eyebrow text-amber">Application received</p>
        <h2 class="h2 mt-6">See you soon.</h2>
        <p class="lede mt-8 max-w-[26em]">We've got it. We'll read your application ourselves and be in touch within {site.replyTime}.</p>
        <p class="mt-10 font-bold">While you're waiting, join the free DD community.</p>
        <a href={href(site.links.community)} class="btn btn-circle mt-5 whitespace-normal" data-community="thanks">Join the free DD community <Arrow /></a>
        <p class="small mt-6 opacity-80"><a href="#notes" class="underline underline-offset-4" data-notes-link>Or get the founding notes once a month.</a></p>
      </div>

      <!-- Soft entry, deliberately quieter -->
      <aside class="mt-14 border-t border-maroon/15 pt-10" aria-labelledby="soft-title" id="notes">
        <p class="eyebrow opacity-70">Not ready to apply?</p>
        <h3 id="soft-title" class="mt-3 text-[24px] font-black tracking-[-0.02em]">Start with DD.</h3>
        <p class="mt-3 max-w-[32em] opacity-85">Join the free DD community or get the founding notes. See the women, ideas and conversations already shaping the network.</p>
        <div class="mt-6 flex flex-col items-start gap-4 sm:flex-row sm:gap-8">
          <a href={href(site.links.community)} class="tlink" data-community="soft">Join the free DD community <Arrow /></a>
          <button type="button" class="tlink hidden [.js_&]:inline-flex" aria-expanded="false" aria-controls="notes-form" data-notes-toggle>Get the founding notes <Arrow /></button>
        </div>
        <form
          id="notes-form"
          name="notes"
          method="POST"
          action="/thanks/notes"
          data-netlify="true"
          netlify-honeypot="company_website"
          novalidate
          class="mt-6 max-w-[460px] [.js_&]:hidden [.js_&.is-open]:block"
          data-notes-form
        >
          <input type="hidden" name="form-name" value="notes" />
          <p class="hidden" aria-hidden="true"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>
          <label for="notes-email" class="label">Your email</label>
          <div class="mt-1 flex items-end gap-3">
            <input id="notes-email" name="email" type="email" autocomplete="email" class="input" required aria-describedby="notes-error" />
            <button type="submit" class="btn btn-primary btn-sm shrink-0">Send me the notes</button>
          </div>
          <p id="notes-error" class="error" hidden data-error></p>
          <p class="small mt-4 hidden font-bold text-crimson" role="status" data-success>Done. The next founding notes will land in your inbox.</p>
        </form>
      </aside>
    </div>
  </div>
</section>
