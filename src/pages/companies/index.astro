---
import Base from "../../layouts/Base.astro";
import AnnouncementBar from "../../components/AnnouncementBar.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import ScriptHeading from "../../components/ScriptHeading.astro";
import Field from "../../components/Field.astro";
import Arrow from "../../components/Arrow.astro";
import { companySeats, companySteps } from "../../data/content";
import { site } from "../../data/site";
---
<Base
  title="DD Network for Companies | Give your best women the room"
  description="DD Network gives women access to a curated peer network outside the company, while giving employers a simple way to sponsor it."
  ogTitle="Give your best women the room."
  ogDescription="DD Network for Companies · Member and Circle seats"
>
  <AnnouncementBar />
  <Navigation />
  <main id="main">
    <!-- Hero -->
    <section class="bg-paper pb-[88px] pt-14 md:pb-[130px] md:pt-24" aria-labelledby="co-title">
      <div class="wrap grid-12 items-end gap-y-10">
        <div class="md:col-span-8">
          <p class="eyebrow text-crimson">For companies</p>
          <ScriptHeading as="h1" id="co-title" text="Give your best women the room." script="room" class="mt-6 max-w-[12ch]" />
        </div>
        <div class="md:col-span-4 md:pb-3">
          <p class="lede">DD Network gives women access to a curated peer network outside the company, while giving employers a simple way to sponsor it.</p>
          <a href="#talk" class="btn btn-primary mt-8">Talk to us about seats</a>
        </div>
      </div>
    </section>

    <!-- Seats -->
    <section class="bg-cream py-[80px] md:py-[120px]" aria-label="Seats">
      <div class="wrap grid gap-6 lg:grid-cols-2 lg:gap-8">
        {companySeats.map((s, i) => (
          <article class:list={["reveal flex flex-col rounded-[28px] p-7 sm:p-10 lg:p-12", i === 0 ? "bg-paper" : "on-dark d1 bg-plum text-paper"]} aria-labelledby={`seat-${s.key}`}>
            <h2 id={`seat-${s.key}`} class="h3">{s.title}</h2>
            <p class="mt-5 text-[20px] font-bold leading-snug">{s.body}</p>
            <p class="mt-8 text-[44px] font-black leading-none tracking-[-0.04em] md:text-[54px]">{s.price}<span class="text-[19px] font-bold tracking-normal opacity-70"> / seat / year</span></p>
            <h3 class:list={["eyebrow mt-10 border-t pt-8", i === 0 ? "border-maroon/15 text-crimson" : "border-paper/20 text-amber"]}>Includes</h3>
            <ul class="mt-4 space-y-2">
              {s.includes.map((it) => <li class="flex gap-3"><span class:list={["mt-[11px] h-1.5 w-1.5 shrink-0 rounded-full", i === 0 ? "bg-maroon" : "bg-gold"]} aria-hidden="true"></span>{it}</li>)}
            </ul>
            <div class="mt-auto pt-10">
              <a href={`?seat=${s.key}#talk`} data-seat={s.key} class:list={["btn w-full", i === 0 ? "btn-primary" : "btn-circle"]}>{s.cta}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-paper py-[80px] md:py-[120px]" aria-labelledby="co-how">
      <div class="wrap">
        <h2 id="co-how" class="h2 reveal">How it works</h2>
        <ol class="mt-14 grid md:mt-16 md:grid-cols-3 md:gap-6">
          {companySteps.map((s, i) => (
            <li class:list={["reveal border-t-2 border-maroon pb-10 pt-6 md:pb-0 md:pr-6", i && `d${i}`]}>
              <span class="block text-[56px] font-black leading-none tracking-[-0.04em] text-crimson md:text-[72px]">{s.n}</span>
              <h3 class="mt-5 text-[28px] font-black leading-tight tracking-[-0.02em]">{s.title}</h3>
              <p class="mt-3 opacity-85">{s.body}</p>
            </li>
          ))}
        </ol>
        <p class="small reveal mt-6 font-bold md:mt-12">Individual conversations remain private.</p>
      </div>
    </section>

    <!-- Form -->
    <section id="talk" class="bg-cream py-[80px] md:py-[120px]" aria-labelledby="talk-title">
      <div class="wrap grid-12 gap-y-12">
        <div class="md:col-span-5">
          <h2 id="talk-title" class="h2">Let's talk seats.</h2>
          <p class="mt-6 max-w-[24em] opacity-85">Tell us a little about your team. We'll reply within {site.replyTime}.</p>
        </div>
        <div class="md:col-span-7 lg:col-span-6 lg:col-start-7" data-company-card>
          <form
            name="companies"
            method="POST"
            action="/companies/thanks"
            data-netlify="true"
            netlify-honeypot="company_website"
            novalidate
            data-company-form
            class="rounded-[28px] bg-paper p-6 sm:p-10"
          >
            <input type="hidden" name="form-name" value="companies" />
            <p class="hidden" aria-hidden="true"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>
            <div class="grid gap-7 sm:grid-cols-2">
              <Field name="company" label="Company" class="sm:col-span-2">
                <input id="f-company" name="company" class="input" autocomplete="organization" required aria-describedby="f-company-error" />
              </Field>
              <Field name="name" label="Your name">
                <input id="f-name" name="name" class="input" autocomplete="name" required aria-describedby="f-name-error" />
              </Field>
              <Field name="email" label="Work email">
                <input id="f-email" name="email" type="email" class="input" autocomplete="email" required aria-describedby="f-email-error" />
              </Field>
              <Field name="role" label="Role">
                <input id="f-role" name="role" class="input" autocomplete="organization-title" required aria-describedby="f-role-error" />
              </Field>
              <Field name="seats" label="Number of seats">
                <input id="f-seats" name="seats" type="number" min="1" inputmode="numeric" class="input" required aria-describedby="f-seats-error" />
              </Field>
            </div>
            <Field name="seat_interest" label="Interest" group class="mt-9">
              <div class="flex flex-wrap gap-2.5">
                {["Network Access", "Leadership Circle", "Both"].map((o) => (
                  <label class="choice"><input type="radio" name="seat_interest" value={o} data-seat-option={o === "Network Access" ? "network" : o === "Leadership Circle" ? "circle" : "both"} required /><span>{o}</span></label>
                ))}
              </div>
            </Field>
            <p class="error mt-6" role="alert" hidden data-form-error></p>
            <button type="submit" class="btn btn-primary mt-10 w-full sm:w-auto" data-submit>Talk to us <Arrow /></button>
          </form>
          <div class="hidden rounded-[28px] bg-plum p-8 text-paper sm:p-12" tabindex="-1" data-company-thanks>
            <p class="eyebrow text-amber">Got it</p>
            <h3 class="h2 mt-6">Thank you. We'll be in touch.</h3>
            <p class="lede mt-6">Someone from the DD team will reply within {site.replyTime} to talk seats.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
