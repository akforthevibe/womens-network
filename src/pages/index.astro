---
import Base from "../layouts/Base.astro";
import Announcement from "../components/sections/Announcement.astro";
import Nav from "../components/sections/Nav.astro";
import Hero from "../components/sections/Hero.astro";
import ProofStrip from "../components/sections/ProofStrip.astro";
import Problem from "../components/sections/Problem.astro";
import ForYou from "../components/sections/ForYou.astro";
import Pillars from "../components/sections/Pillars.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Hosts from "../components/sections/Hosts.astro";
import Voices from "../components/sections/Voices.astro";
import Circle from "../components/sections/Circle.astro";
import Membership from "../components/sections/Membership.astro";
import Companies from "../components/sections/Companies.astro";
import Faq from "../components/sections/Faq.astro";
import Founding from "../components/sections/Founding.astro";
import Request from "../components/sections/Request.astro";
import Footer from "../components/sections/Footer.astro";
import { photos, photoSrcset } from "../data/photos";
---
<Base>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={photoSrcset(photos.hero, [420, 640, 920], 1.25)}
    imagesizes="(min-width: 1024px) 460px, (min-width: 480px) 420px, 92vw"
    fetchpriority="high"
  />
  <Announcement />
  <Nav />
  <main id="main">
    <Hero />
    <ProofStrip />
    <Problem />
    <ForYou />
    <Pillars />
    <HowItWorks />
    <Hosts />
    <Voices />
    <Circle />
    <Membership />
    <Companies />
    <Faq />
    <Founding />
    <Request />
  </main>
  <Footer />
  <script>
    import "../scripts/main.ts";
  </script>
</Base>
