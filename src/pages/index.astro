---
import Base from "../layouts/Base.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import ProblemSection from "../components/ProblemSection.astro";
import ChapterSection from "../components/ChapterSection.astro";
import FitSection from "../components/FitSection.astro";
import Pillars from "../components/Pillars.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FoundingHosts from "../components/FoundingHosts.astro";
import MemberVoices from "../components/MemberVoices.astro";
import CircleSection from "../components/CircleSection.astro";
import Membership from "../components/Membership.astro";
import CompaniesTeaser from "../components/CompaniesTeaser.astro";
import FAQ from "../components/FAQ.astro";
import Founding50 from "../components/Founding50.astro";
import InviteForm from "../components/InviteForm.astro";
import Footer from "../components/Footer.astro";
import StickyCTA from "../components/StickyCTA.astro";
import { photos, photoSrcset, heroImage } from "../data/photos";
---
<Base>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={photoSrcset(photos.hero, heroImage.widths, heroImage.ratio)}
    imagesizes={heroImage.sizes}
    fetchpriority="high"
  />
  <AnnouncementBar />
  <Navigation />
  <main id="main">
    <Hero />
    <ProofStrip />
    <ProblemSection />
    <ChapterSection />
    <FitSection />
    <Pillars />
    <HowItWorks />
    <FoundingHosts />
    <MemberVoices />
    <CircleSection />
    <Membership />
    <CompaniesTeaser />
    <FAQ />
    <Founding50 />
    <InviteForm />
  </main>
  <Footer />
  <StickyCTA />
</Base>
