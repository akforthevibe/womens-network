---
// Shown when a form is sent without JavaScript. With JavaScript the thank-you state replaces the form in place.
import Base from "../layouts/Base.astro";
import Newsletter from "../components/ui/Newsletter.astro";
import { site } from "../data/site";
---
<Base title="Thank you | DD Network" noindex>
  <main id="main" class="section flex min-h-[80vh] items-center bg-cream">
    <div class="wrap max-w-[680px]">
      <a href="/" class="font-display text-[26px] font-bold">DD Network</a>
      <div class="frame frame-rounded mt-10 mr-[14px]">
        <div class="card bg-paper p-8 sm:p-10">
          <div data-thanks-invite>
            <h1 class="font-display text-[34px] font-bold leading-tight text-paprika">Thank you.</h1>
            <p class="mt-4">We read every application ourselves and reply within {site.replyTime}.</p>
            <Newsletter class="mt-8" />
          </div>
          <p class="hidden font-display text-[28px] font-bold text-paprika" data-thanks-newsletter-only>You're in. Look out for our first note.</p>
        </div>
      </div>
      <p class="mt-10"><a href="/" class="link text-paprika">Back to DD Network</a></p>
    </div>
  </main>
  <script is:inline>
    if (new URLSearchParams(location.search).has("newsletter")) {
      document.querySelector("[data-thanks-invite]").classList.add("hidden");
      document.querySelector("[data-thanks-newsletter-only]").classList.remove("hidden");
    }
  </script>
</Base>
