---
// Shown only when JavaScript is off and the founding notes form posts normally.
import LegalLayout from "../../components/LegalLayout.astro";
---
<LegalLayout title="You're on the list | DD Network" description="Founding notes sign-up received." noindex>
  <div class="wrap max-w-[800px]">
    <p class="eyebrow text-crimson">Founding notes</p>
    <h1 class="h2 mt-6">You're on the list.</h1>
    <p class="lede mt-8">The next founding notes will land in your inbox.</p>
    <a href="/" class="btn btn-primary mt-10">Back to DD Network</a>
  </div>
</LegalLayout>
